# Copy to .env.local. In development the client defaults to http://localhost:8080.
# In production set this to your deployed server, or leave it empty to run
# without live stats and AI readings.
REACT_APP_API_URL=

# Set to true to show the AI-written reading on the result page.
# Needs REACT_APP_API_URL and a server with ANTHROPIC_API_KEY.
REACT_APP_AI_READING=false
