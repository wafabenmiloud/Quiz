# Copy to .env and fill in. Never commit the real .env.

# MongoDB connection string — needed for saving results and live stats
MONGODB_URI=

# Browser origins allowed to call the API (comma-separated)
CLIENT_ORIGIN=http://localhost:3000

# Long random string. Send it as the `x-admin-token` header to list or delete
# results and to seed or delete questions. Leave empty to disable those routes.
ADMIN_TOKEN=

# Enables the AI-written reading on the result page (each reading is a paid API call)
ANTHROPIC_API_KEY=

PORT=8080
